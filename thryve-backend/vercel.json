{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "dest": "/uploads/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https:; connect-src 'self' https://thryve-admin-omega.vercel.app; font-src 'self' data:;"
        }
      ]
    }
  ]
}
